# ─────────────────────────────────────────────
# LLM Provider
# Options: "gemini" | "llama" | "openai" | "mock"
# ─────────────────────────────────────────────
LLM_PROVIDER=gemini

# RAG flow mode: "baseline" | "agentic"
RAG_MODE=baseline

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=

# Llama 3 — local Ollama or OpenAI-compatible endpoint
LLAMA_BASE_URL=http://localhost:11434
LLAMA_MODEL=llama3

# OpenAI (only if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# ─────────────────────────────────────────────
# Database (PostgreSQL 16 + pgvector)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/scholaragent
PG_POOL_MAX=10
PG_POOL_MIN=1
# Set to "disable" for local Docker Postgres without TLS
PG_SSLMODE=disable

# Supabase auth verification (optional)
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_JWT_SECRET=

# ─────────────────────────────────────────────
# Chat history & context budget (PostgreSQL)
# ─────────────────────────────────────────────
CHAT_HISTORY_FETCH_LIMIT=40
CHAT_MAX_HISTORY_TURNS=10
CHAT_MAX_CONTEXT_CHARS=24000
CHAT_MAX_CONTEXT_TOKENS=6000
CHAT_MAX_INBOUND_CHARS=8000
CHAT_CHARS_PER_TOKEN=4

# ─────────────────────────────────────────────
# Web Search
# ─────────────────────────────────────────────
TAVILY_API_KEY=

# ─────────────────────────────────────────────
# WhatsApp Cloud API
# ─────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─────────────────────────────────────────────
# Observability (optional)
# ─────────────────────────────────────────────
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=

# Hard-delete webhook for knowledge_base chunks
DOCUMENT_WEBHOOK_SECRET=

# Vercel sets VERCEL=1 automatically — enables waitUntil() for webhook background work
# VERCEL=1
