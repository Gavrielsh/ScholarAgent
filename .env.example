# ─────────────────────────────────────────────
# LLM Provider
# Options: "gemini" | "claude" | "openai" | "mock"
# ─────────────────────────────────────────────
LLM_PROVIDER=gemini

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=

# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Main model (default: claude-3-5-sonnet-20240620)
CLAUDE_MODEL=claude-3-5-sonnet-20240620
# Fast/lightweight model used for intent classification (default: claude-3-haiku-20240307)
CLAUDE_FAST_MODEL=claude-3-haiku-20240307
# Maximum tokens per response (default: 4096)
CLAUDE_MAX_TOKENS=4096

# OpenAI (only if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# ─────────────────────────────────────────────
# Database (PostgreSQL 16 + pgvector)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/scholaragent
# Service-role URL for DLS evaluation (unrestricted retrieval). Use a BYPASSRLS role in production.
DATABASE_SERVICE_URL=postgresql://postgres:password@localhost:5432/scholaragent
PG_POOL_MAX=10
PG_SERVICE_POOL_MAX=3
PG_POOL_MIN=1
# Set to "disable" for local Docker Postgres without TLS
PG_SSLMODE=disable

# Supabase auth verification (optional)
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_JWT_SECRET=

# ─────────────────────────────────────────────
# Chat history & context budget (PostgreSQL)
# ─────────────────────────────────────────────
CHAT_HISTORY_FETCH_LIMIT=40
CHAT_MAX_HISTORY_TURNS=10
CHAT_MAX_CONTEXT_CHARS=24000
CHAT_MAX_CONTEXT_TOKENS=6000
CHAT_MAX_INBOUND_CHARS=8000
CHAT_CHARS_PER_TOKEN=4

# ─────────────────────────────────────────────
# Web Search
# ─────────────────────────────────────────────
TAVILY_API_KEY=

# ─────────────────────────────────────────────
# Redis (idempotency + BullMQ)
#
# The queue has exactly ONE consumer: `npm run worker:whatsapp`. The Next.js
# process is a producer only — do not start a worker inside it.
# ─────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
WHATSAPP_QUEUE_CONCURRENCY=5
WHATSAPP_QUEUE_RATE_LIMIT_MAX=10
WHATSAPP_QUEUE_RATE_LIMIT_DURATION_MS=1000
# Hard wall-clock ceiling per job. The BullMQ lock is set to this + 30s so the
# deadline fires before the job is ever declared stalled.
WHATSAPP_JOB_TIMEOUT_MS=90000
# Grace period for in-flight jobs on SIGTERM/SIGINT. Keep BELOW the platform's
# kill grace period (Docker/Kubernetes default to 30s) or the drain is SIGKILLed.
WORKER_SHUTDOWN_TIMEOUT_MS=25000

# ─────────────────────────────────────────────
# Document ingestion queue (WhatsApp uploads by L0/L1 admins)
#
# Separate queue, separate limits: an ingestion job holds the whole file in
# memory and burns embedding quota, so it must not compete for the chat
# worker's concurrency slots. Consumed by the same `npm run worker:whatsapp`.
# ─────────────────────────────────────────────
DOCUMENT_QUEUE_CONCURRENCY=2
DOCUMENT_QUEUE_RATE_LIMIT_MAX=4
DOCUMENT_QUEUE_RATE_LIMIT_DURATION_MS=60000
DOCUMENT_INGESTION_JOB_ATTEMPTS=3
# Download + parse + N embedding slices, each of which may back off on a 429.
DOCUMENT_JOB_TIMEOUT_MS=300000
# Chunks per embedding request. Small slices keep each call under the free-tier
# quota so a 429 stays rare and cheap to retry.
DOCUMENT_EMBED_BATCH_SIZE=16
DOCUMENT_EMBED_BATCH_PAUSE_MS=250
# Refuses documents that would consume an entire quota window in one job.
DOCUMENT_MAX_CHUNKS=400

# ─────────────────────────────────────────────
# Outbound HTTP timeouts
#
# Node's global fetch has NO default timeout: one half-open socket permanently
# consumes a worker concurrency slot. Every external call is wrapped by
# lib/http/fetchWithTimeout.ts.
# ─────────────────────────────────────────────
HTTP_DEFAULT_TIMEOUT_MS=15000
WHATSAPP_HTTP_TIMEOUT_MS=15000
# Read receipts / typing indicators are pure UX and sit ahead of the answer.
WHATSAPP_TYPING_TIMEOUT_MS=5000
EMBEDDING_TIMEOUT_MS=15000
EMBEDDING_BATCH_TIMEOUT_MS=45000
# Bounded LRU for query + chunk embeddings; prevents unbounded growth in the
# long-lived worker process.
EMBEDDING_CACHE_MAX=5000

# ─────────────────────────────────────────────
# WhatsApp Cloud API
# ─────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta App Secret — REQUIRED in production. Used to verify the X-Hub-Signature-256
# HMAC on every inbound webhook. If unset, signature verification is skipped and a
# warning is logged, which leaves the webhook open to forged payloads.
WHATSAPP_APP_SECRET=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v20.0
# Media download (inbound documents). The size cap is enforced while streaming,
# so a misreported content-length cannot make the worker allocate an unbounded
# buffer. The download budget is wider than a normal call: it moves megabytes.
WHATSAPP_MEDIA_MAX_BYTES=20971520
WHATSAPP_MEDIA_METADATA_TIMEOUT_MS=15000
WHATSAPP_MEDIA_DOWNLOAD_TIMEOUT_MS=60000

# ─────────────────────────────────────────────
# Observability (optional)
# ─────────────────────────────────────────────
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=

# Hard-delete webhook for knowledge_base chunks
DOCUMENT_WEBHOOK_SECRET=

# Vercel sets VERCEL=1 automatically — enables waitUntil() for webhook background work
# VERCEL=1
