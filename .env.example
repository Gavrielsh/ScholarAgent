# ─────────────────────────────────────────────
# LLM Provider
# Options: "gemini" | "claude" | "openai" | "mock"
# ─────────────────────────────────────────────
LLM_PROVIDER=gemini

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=

# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Main model (default: claude-3-5-sonnet-20240620)
CLAUDE_MODEL=claude-3-5-sonnet-20240620
# Fast/lightweight model used for intent classification (default: claude-3-haiku-20240307)
CLAUDE_FAST_MODEL=claude-3-haiku-20240307
# Maximum tokens per response (default: 4096)
CLAUDE_MAX_TOKENS=4096

# OpenAI (only if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# ─────────────────────────────────────────────
# Database (PostgreSQL 16 + pgvector)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/scholaragent
# Service-role URL for DLS evaluation (unrestricted retrieval). Use a BYPASSRLS role in production.
DATABASE_SERVICE_URL=postgresql://postgres:password@localhost:5432/scholaragent
PG_POOL_MAX=10
PG_SERVICE_POOL_MAX=3
PG_POOL_MIN=1
# Set to "disable" for local Docker Postgres without TLS
PG_SSLMODE=disable

# Supabase auth verification (optional)
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_JWT_SECRET=

# ─────────────────────────────────────────────
# Chat history & context budget (PostgreSQL)
# ─────────────────────────────────────────────
CHAT_HISTORY_FETCH_LIMIT=40
CHAT_MAX_HISTORY_TURNS=10
CHAT_MAX_CONTEXT_CHARS=24000
CHAT_MAX_CONTEXT_TOKENS=6000
CHAT_MAX_INBOUND_CHARS=8000
CHAT_CHARS_PER_TOKEN=4

# ─────────────────────────────────────────────
# Web Search
# ─────────────────────────────────────────────
TAVILY_API_KEY=

# ─────────────────────────────────────────────
# Redis (idempotency + BullMQ)
# ─────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
WHATSAPP_QUEUE_CONCURRENCY=5
WHATSAPP_QUEUE_RATE_LIMIT_MAX=10
WHATSAPP_QUEUE_RATE_LIMIT_DURATION_MS=1000

# ─────────────────────────────────────────────
# WhatsApp Cloud API
# ─────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v20.0

# ─────────────────────────────────────────────
# Observability (optional)
# ─────────────────────────────────────────────
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=

# Hard-delete webhook for knowledge_base chunks
DOCUMENT_WEBHOOK_SECRET=

# Vercel sets VERCEL=1 automatically — enables waitUntil() for webhook background work
# VERCEL=1
