# Secrets — never commit
.env.local
.env*.local
google-credentials.json

# Dependencies and build output
node_modules/
.next/
.swc/
*.tsbuildinfo

# Local corpus. The ingestion source directory: documents dropped here are the
# organisation's own material and must not reach a public repository.
# Real organisational documents never enter the repo. Written as `local_data/*`
# rather than `local_data/`: a trailing-slash pattern excludes the directory
# itself, so git never descends into it and a later negation cannot re-include
# anything inside.
local_data/*
# ...except the synthetic evaluation corpus. It contains no real people, and the
# benchmark's numbers are not reproducible without the exact documents they were
# measured against, so it belongs under version control.
!local_data/eval_corpus/

# Regenerated benchmark/evaluation artifacts (`npm run benchmark` / `evaluate`).
# Written as `scripts/output/*` rather than `scripts/output/`: a trailing-slash
# pattern excludes the directory itself, so a later negation cannot re-include
# anything inside.
scripts/output/*
# ...except the files committed as evidence for the thesis's reported
# benchmark and evaluation numbers.
!scripts/output/.gitkeep
!scripts/output/benchmark_summary.md
!scripts/output/evaluation_results_2026-11-18_11-04-54.csv

# Editor and assistant state — machine-local, not project configuration
.cursor/
.claude/
skills-lock.json
.agents/

# OneDrive sync-conflict copies, which it names after the machine
*-Gavriel*

# Graphify
.graphify/
graphify-out/

scholaragent_context.txt
