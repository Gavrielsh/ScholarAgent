# syntax=docker/dockerfile:1

FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json tsconfig.json ./
COPY lib ./lib
COPY scripts ./scripts

# Exec `node` directly instead of `npm run worker:whatsapp`.
#
# `npm run` launches the script through a shell, and neither npm nor `sh -c`
# reliably forwards SIGTERM to the grandchild. As PID 1 that means Docker's stop
# signal is swallowed, the graceful shutdown in scripts/whatsapp-worker.ts never
# runs, and every deploy SIGKILLs the container mid-job. Exec form makes node
# PID 1 so it receives the signal itself.
#
# Node as PID 1 has no default SIGTERM handler and would ignore the signal
# outright — the handlers registered in whatsapp-worker.ts are what make this
# work, so the two must stay in sync.
#
# `--import tsx` rather than `--require ts-node/register`: the CJS `--require`
# hook does not cover Node's ESM resolver, which is the path actually taken here,
# so the container crash-looped on `Unknown file extension ".ts"`. tsx registers
# both hooks and resolves the `@/*` tsconfig paths natively — which is also why
# the old `tsconfig-paths/register` is gone; that package is not even a
# dependency of this project. Keeps node as PID 1, so signal handling is
# unaffected. This mirrors how the worker is run locally.
CMD ["node", "--import", "tsx", "scripts/whatsapp-worker.ts"]
